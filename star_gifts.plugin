from typing import Any, List

from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType
from client_utils import send_text, get_user_config
from ui.bulletin import BulletinHelper
from ui.settings import Header, Input, Switch, Text

__id__ = "star_gifts"
__name__ = "Star Gifts"
__description__ = "Візуально кидає зіркові подарунки: команда `.gift` та пункт у меню повідомлення"
__author__ = "@you"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = "fun"

DEFAULT_TEMPLATE = "\U0001F381 {sender} дарує {stars} \u2B50 \u2014 лови подарунок!"
DEFAULT_STARS = "50"
COMMANDS = (".gift", ".\u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043E\u043A", ".stars")


class StarGiftsPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.menu_item_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text="\u041D\u0430\u0434\u0456\u0441\u043B\u0430\u0442\u0438 \u0437\u0456\u0440\u043A\u043E\u0432\u0438\u0439 \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043E\u043A",
                on_click=self._send_gift_from_menu,
                icon="msg_info",
                priority=10,
            )
        )
        self.logger.info("Star Gifts loaded")

    def on_plugin_unload(self):
        if getattr(self, "menu_item_id", None):
            self.remove_menu_item(self.menu_item_id)

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Star Gifts"),
            Input(
                key="template",
                text="\u0428\u0430\u0431\u043B\u043E\u043D \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043A\u0430",
                default=DEFAULT_TEMPLATE,
                subtext="{sender} \u2014 \u0456\u043C'\u044F, {stars} \u2014 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0437\u0456\u0440\u043E\u043A",
                icon="msg_edit",
            ),
            Input(
                key="stars",
                text="\u0417\u0456\u0440\u043E\u043A \u0437\u0430 \u0437\u0430\u043C\u043E\u0432\u0447\u0443\u0432\u0430\u043D\u043D\u044F\u043C",
                default=DEFAULT_STARS,
                icon="msg_text",
            ),
            Switch(
                key="bulletin",
                text="\u0421\u043F\u043E\u0432\u0456\u0449\u0435\u043D\u043D\u044F \u043F\u0456\u0441\u043B\u044F \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043A\u0438",
                default=True,
            ),
            Text(
                text="\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F",
                subtext=".gift, .gift 100 \u0430\u0431\u043E .\u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043E\u043A \u2014 \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443 \u0447\u0430\u0442\u0456",
                icon="msg_info",
            ),
        ]

    def _my_name(self) -> str:
        try:
            user = get_user_config().getCurrentUser()
            if user:
                return user.first_name or "\u0422\u0438"
        except Exception:
            pass
        return "\u0422\u0438"

    def _build_text(self, stars: str) -> str:
        template = self.get_setting("template", DEFAULT_TEMPLATE)
        try:
            return template.format(sender=self._my_name(), stars=stars)
        except Exception:
            return f"\U0001F381 {self._my_name()} \u0434\u0430\u0440\u0443\u0454 {stars} \u2B50 \u2014 \u043B\u043E\u0432\u0438 \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043E\u043A!"

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not isinstance(getattr(params, "message", None), str):
            return HookResult()

        raw = params.message.strip()
        command = next((c for c in COMMANDS if raw.startswith(c)), None)
        if not command:
            return HookResult()

        parts = raw.split()
        stars = parts[1] if len(parts) > 1 else self.get_setting("stars", DEFAULT_STARS)
        if not str(stars).isdigit():
            stars = self.get_setting("stars", DEFAULT_STARS)

        params.message = self._build_text(stars)
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def _send_gift_from_menu(self, context):
        dialog_id = context.get("dialog_id")
        if dialog_id is None:
            message = context.get("message")
            if message:
                try:
                    dialog_id = message.getDialogId()
                except Exception:
                    dialog_id = None

        if dialog_id is None:
            self.logger.warning("No dialog_id in menu context")
            return

        stars = self.get_setting("stars", DEFAULT_STARS)
        send_text(int(dialog_id), self._build_text(stars))

        if self.get_setting("bulletin", True):
            BulletinHelper.show_info(f"\U0001F381 \u041F\u043E\u0434\u0430\u0440\u0443\u043D\u043E\u043A \u043D\u0430\u0434\u0456\u0441\u043B\u0430\u043D\u043E: {stars} \u2B50")
